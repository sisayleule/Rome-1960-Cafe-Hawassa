{
  "rewrites": [
    { "source": "/about",    "destination": "/pages/about.html" },
    { "source": "/menu",     "destination": "/pages/menu.html" },
    { "source": "/services", "destination": "/pages/services.html" },
    { "source": "/gallery",  "destination": "/pages/gallery.html" },
    { "source": "/contact",  "destination": "/pages/contact.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
